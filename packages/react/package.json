{
  "name": "@shader-ui/react",
  "version": "0.1.0",
  "description": "Shader UI pour React et Next.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build --prefix ../core && npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp ../core/src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shader-ui/core": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "shader",
    "webgl",
    "ui",
    "components",
    "accessibility",
    "react",
    "nextjs"
  ]
}
